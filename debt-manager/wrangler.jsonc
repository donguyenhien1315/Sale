{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "debt-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "debt-manager-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
